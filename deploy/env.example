# What install.sh writes to .env (next to stack.yml). Only needed when deploying by hand:
#   set -a; . ./.env; set +a; docker stack deploy --with-registry-auth -c stack.yml fridge
# Required values are marked; the stack refuses to deploy while one is empty.

# REQUIRED. Password of the metadata Postgres (fridge-meta). URL-safe characters: it goes into FRIDGE_DATABASE_URL.
#   openssl rand -hex 16
FRIDGE_META_PASSWORD=

# REQUIRED. Encrypts database passwords and S3 secrets. Base64 of exactly 32 bytes. Keep it: losing it loses them,
# and never change it on a running install.
#   openssl rand -base64 32
FRIDGE_SECRET_KEY=

# REQUIRED. Bearer token Traefik uses to fetch its routes (and private keys) from Fridge.
#   openssl rand -hex 24
FRIDGE_PROVIDER_TOKEN=

# Needed only to create the first admin (web UI "Setup" page or `fridge setup`); ignored once any user exists.
#   openssl rand -hex 16
FRIDGE_SETUP_TOKEN=

# Host names / IPs the web UI is reached by, comma separated. They go into the web certificate
# (localhost and 127.0.0.1 are always there). Example: fridge.lan,192.168.1.10
FRIDGE_PUBLIC_HOSTS=

# Images. FRIDGE_IMAGE is the server (also used for the edge sidecars), FRIDGE_JOB_IMAGE the dump/restore/check jobs.
# FRIDGE_IMAGE=ghcr.io/morningstar-sudo/fridge:latest
# FRIDGE_JOB_IMAGE=ghcr.io/morningstar-sudo/fridge-job:latest

# Peers whose X-Forwarded-For is believed, as CIDRs. Empty = the fridge_edge subnet (where Traefik lives).
# FRIDGE_TRUSTED_PROXY=

# Receives POST {"text": "..."} on failed backups/restores. Empty = log only.
FRIDGE_ALERT_WEBHOOK=

# Time zone of the backup schedules' cron expressions, e.g. Asia/Ho_Chi_Minh.
TZ=UTC
