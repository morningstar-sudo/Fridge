# Copy to deploy/.env (gitignored) and fill in. Compose refuses to start while a required value is empty.

# Password of the metadata Postgres (fridge-meta). Use URL-safe characters: it goes into FRIDGE_DATABASE_URL.
#   openssl rand -hex 16
FRIDGE_META_PASSWORD=

# Encrypts database passwords and S3 secrets. Base64 of exactly 32 bytes. Keep it: losing it loses them.
#   openssl rand -base64 32
FRIDGE_SECRET_KEY=

# Needed only to create the first admin (web UI "Setup" page or `fridge setup`); ignored once any user exists.
#   openssl rand -hex 32
FRIDGE_SETUP_TOKEN=

# Host names / IPs the web UI is reached by, comma separated. They go into the web certificate
# (localhost and 127.0.0.1 are always there). Example: fridge.lan,192.168.1.10
FRIDGE_PUBLIC_HOSTS=

# Peers whose X-Forwarded-For is believed, as CIDRs. Empty = the fridge-net subnet (where Traefik lives).
# FRIDGE_TRUSTED_PROXY=

# Receives POST {"text": "..."} on failed backups/restores. Empty = log only.
FRIDGE_ALERT_WEBHOOK=

# Time zone of the backup schedules' cron expressions, e.g. Asia/Ho_Chi_Minh.
TZ=UTC
